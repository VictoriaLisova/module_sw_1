ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

<http://example.org/mkr/stmt/FL-2754-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 10 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2754> .

<http://example.org/mkr/stmt/FL-6049-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6049> .

<http://example.org/mkr/stmt/FL-6481-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6481> .

<http://example.org/mkr/stmt/FL-7617-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
